{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "name": "ideaforge-ai",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "ee7b4aa2753f43e0ac1f80be4560d7be"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
