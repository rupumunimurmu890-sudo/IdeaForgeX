{
  // ============================================================
  // IdeaForge-AI — Cloudflare Worker Configuration
  // Worker version: 13.0
  // ============================================================
  //
  // Deploy:
  //   npx wrangler deploy
  //
  // Local dev:
  //   npx wrangler dev
  //
  // Tail logs:
  //   npx wrangler tail
  //
  // NOTE: JSONC = JSON with comments. Sections use {} objects,
  //       NOT [section] TOML syntax. Do not mix the two formats.
  // ============================================================

  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",

  "name": "ideaforge-ai",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",

  // ------------------------------------------------------------
  // Static Assets
  // ------------------------------------------------------------
  // Files in ./public are served by Cloudflare's asset pipeline.
  // Only /api/* requests are routed to the Worker first; all
  // other paths go straight to the asset pipeline.
  //
  // REQUIRES wrangler v4.x for array syntax below.
  // On wrangler v3.x, replace with: "run_worker_first": true
  // ------------------------------------------------------------
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // ------------------------------------------------------------
  // Workers AI Binding
  // ------------------------------------------------------------
  // Enables env.AI.run(...) in worker.js.
  // Models used:
  //   heavy  → @cf/meta/llama-3.3-70b-instruct-fp8-fast
  //   medium → @cf/meta/llama-3.1-8b-instruct
  //   fast   → @cf/meta/llama-3.1-8b-instruct
  //   vision → @cf/meta/llama-4-scout-17b-16e-instruct
  //   image  → @cf/black-forest-labs/flux-1-schnell
  // ------------------------------------------------------------
  "ai": {
    "binding": "AI"
  },

  // ------------------------------------------------------------
  // KV Namespace — Sessions, Quota, User Data Backup
  // ------------------------------------------------------------
  // Used for:
  //   session:<sessionId>              → session record
  //   quota:<sessionId>:<YYYY-MM-DD>   → daily usage counter
  //   udata:<sessionId>:<type>         → projects/history/brand/toolhistory
  //
  // DO NOT change `id` unless you also migrate the KV data.
  // ------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "ee7b4aa2753f43e0ac1f80be4560d7be"
    }
  ],

  // ------------------------------------------------------------
  // Observability
  // ------------------------------------------------------------
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
