{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universal-helper",
  "main": "worker.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "ai": {
    "binding": "AI"
  }
}
