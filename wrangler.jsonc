{
  // ============================================================
  // IdeaForgeX — Cloudflare Worker Configuration
  // Worker version: 13.0
  // ============================================================
  //
  // Deploy:
  //   npx wrangler deploy
  //
  // Local dev:
  //   npx wrangler dev
  //
  // Tail logs:
  //   npx wrangler tail
  //
  // NOTE: JSONC = JSON with comments. Sections use {} objects,
  //       NOT [section] TOML syntax. Do not mix the two formats.
  // ============================================================

  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",

  "name": "universal-helper",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",

  // ------------------------------------------------------------
  // Static Assets
  // ------------------------------------------------------------
  // Files in ./public (index.html, app.js, style.css, etc.) are
  // served by Cloudflare's asset pipeline. Only /api/* requests
  // are routed to the Worker first; everything else goes straight
  // to the asset pipeline (faster + cheaper).
  // ------------------------------------------------------------
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // ------------------------------------------------------------
  // Workers AI Binding
  // ------------------------------------------------------------
  // Enables env.AI.run(...) in worker.js.
  // Models used:
  //   heavy  → @cf/meta/llama-3.3-70b-instruct-fp8-fast
  //   medium → @cf/meta/llama-3.1-8b-instruct
  //   fast   → @cf/meta/llama-3.1-8b-instruct
  //   vision → @cf/meta/llama-4-scout-17b-16e-instruct
  //   image  → @cf/black-forest-labs/flux-1-schnell
  // ------------------------------------------------------------
  "ai": {
    "binding": "AI"
  },

  // ------------------------------------------------------------
  // KV Namespace — Sessions, Quota, User Data Backup
  // ------------------------------------------------------------
  // Used for:
  //   session:<sessionId>              → session record
  //   quota:<sessionId>:<YYYY-MM-DD>   → daily usage counter
  //   udata:<sessionId>:<type>         → projects/history/brand/toolhistory
  //
  // DO NOT change `id` unless you also migrate the KV data.
  // To create a new namespace:
  //   npx wrangler kv namespace create SESSIONS_KV
  // ------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "ee7b4aa2753f43e0ac1f80be4560d7be"
    }
  ],

  // ------------------------------------------------------------
  // Observability
  // ------------------------------------------------------------
  // Full head sampling so errors and slow requests show up in
  // the Cloudflare dashboard / wrangler tail.
  // ------------------------------------------------------------
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }

  // ============================================================
  // OPTIONAL: Environment-specific overrides
  // ============================================================
  //
  // "env": {
  //   "staging": {
  //     "name": "universal-helper-staging",
  //     "compatibility_date": "2025-01-01",
  //     "assets": {
  //       "directory": "public",
  //       "binding": "ASSETS",
  //       "run_worker_first": ["/api/*"]
  //     },
  //     "ai": { "binding": "AI" },
  //     "kv_namespaces": [
  //       { "binding": "SESSIONS_KV", "id": "PASTE_STAGING_KV_ID" }
  //     ]
  //   }
  // }
  //
  // Deploy staging:  npx wrangler deploy --env staging
  //
  // ============================================================
  // OPTIONAL: Custom domain
  // ============================================================
  //
  // "routes": [
  //   { "pattern": "app.yourdomain.com", "custom_domain": true }
  // ]
  //
  // ============================================================
  // OPTIONAL: Non-secret environment variables
  // ============================================================
  //
  // "vars": {
  //   "APP_ENV": "production"
  // }
  //
  // For secrets, use:  npx wrangler secret put MY_SECRET
  //
  // ============================================================
}
